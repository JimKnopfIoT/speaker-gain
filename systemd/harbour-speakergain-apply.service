# Applies an output volume set in Speaker Gain for an output that was not in
# use at the time. PulseAudio files a route volume only under the route in
# use, so the value waits until that route is; this waits with it, applies it
# and quits. Enabled by the app when a value is waiting, disabled by itself
# when none is left.
[Unit]
Description=Speaker Gain: apply waiting output volumes
After=pulseaudio.service

[Service]
Type=simple
ExecStart=/usr/bin/harbour-speakergain --apply-pending
Restart=no

[Install]
WantedBy=post-user-session.target
